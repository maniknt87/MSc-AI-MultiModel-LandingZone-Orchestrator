{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPipelineIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "TerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mani-terraform-state-699754982224"
    },
    {
      "Sid": "TerraformStateObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::mani-terraform-state-699754982224/*"
    },
    {
      "Sid": "TerraformStateLock",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:699754982224:table/mani-terraform-lock"
    },
    {
      "Sid": "ManageRegionalModelArtifactBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:ListBucket",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::ai-model-artifacts-699754982224-*"
    },
    {
      "Sid": "ManageModelArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::ai-model-artifacts-699754982224-*/models/*"
    },
    {
      "Sid": "ManageLandingZoneNetworking",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": [
            "ap-south-1",
            "us-east-1",
            "eu-west-1"
          ]
        }
      }
    },
    {
      "Sid": "ManageNetworkFirewall",
      "Effect": "Allow",
      "Action": "network-firewall:*",
      "Resource": [
        "arn:aws:network-firewall:ap-south-1:699754982224:*",
        "arn:aws:network-firewall:us-east-1:699754982224:*",
        "arn:aws:network-firewall:eu-west-1:699754982224:*"
      ]
    },
    {
      "Sid": "InspectNetworkFirewallLogDeliveries",
      "Effect": "Allow",
      "Action": "logs:ListLogDeliveries",
      "Resource": "*"
    },
    {
      "Sid": "ManageProjectSageMakerResources",
      "Effect": "Allow",
      "Action": [
        "sagemaker:AddTags",
        "sagemaker:CreateEndpoint",
        "sagemaker:CreateEndpointConfig",
        "sagemaker:CreateModel",
        "sagemaker:DeleteEndpoint",
        "sagemaker:DeleteEndpointConfig",
        "sagemaker:DeleteModel",
        "sagemaker:DescribeEndpoint",
        "sagemaker:DescribeEndpointConfig",
        "sagemaker:DescribeModel",
        "sagemaker:ListTags",
        "sagemaker:UpdateEndpoint",
        "sagemaker:UpdateEndpointWeightsAndCapacities"
      ],
      "Resource": [
        "arn:aws:sagemaker:*:699754982224:endpoint/sentiment-*",
        "arn:aws:sagemaker:*:699754982224:endpoint-config/sentiment-config-*",
        "arn:aws:sagemaker:*:699754982224:model/sentiment-model-*",
        "arn:aws:sagemaker:*:699754982224:endpoint/ner-*",
        "arn:aws:sagemaker:*:699754982224:endpoint-config/ner-config-*",
        "arn:aws:sagemaker:*:699754982224:model/ner-model-*"
      ]
    },
    {
      "Sid": "ManageSageMakerExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::699754982224:role/sm-*"
    },
    {
      "Sid": "PassSageMakerExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::699754982224:role/sm-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "sagemaker.amazonaws.com"
        }
      }
    }
  ]
}
